# PostgreSQL — usado por Prisma (ver prisma/schema.prisma)
# Local: postgresql://usuario:password@localhost:5432/nomada_pos
# Supabase (cuando se integre): usar el connection string de Database Settings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nomada_pos"

# Nombre de la cookie de sesion (ver lib/session.ts).
SESSION_COOKIE_NAME="nomada_pos_session"

# Password de sellado/firma de la sesion (iron-session). Debe tener al menos
# 32 caracteres aleatorios. Genera uno propio para cada entorno, ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No reusar el mismo secreto entre entornos (dev/staging/prod).
SESSION_SECRET="reemplaza-esto-con-una-cadena-aleatoria-de-32-o-mas-caracteres"
