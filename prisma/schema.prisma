// =========================================================================
// Nomada Café POS — Fase 0
// Schema base derivado de ADR-001 + Respuestas Fase 0 (modelo de datos)
// =========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UnitOfMeasure {
  KG // kilogramo
  G // gramo
  L // litro
  ML // mililitro
  PUMP // pump de jarabe
  PIEZA // unidad/pieza
  CUCHARADA // cucharada (topping)
  ESPRESSO_SHOT // unidad de espresso (18g)
}

enum IngredientCategory {
  CAFE
  JARABES
  LECHE
  TOPPINGS
  INSUMOS // vasos, tapas, popotes, servilletas, etc.
}

enum IngredientKind {
  ATOMICO // se compra directo a proveedor
  COMPUESTO // se arma con otros ingredientes vía Recipe, pero no se
  // descuenta directo del inventario — ver Recipe.kind = COMPUESTO
}

enum ProductType {
  RECETA // pasa por el modelo de receta/inventario por ingrediente
  REVENTA_DIRECTA // ej. merch, café en bolsa, postres, bebidas de aparador
}

enum RecipeKind {
  PRODUCTO_VENDIBLE // receta final de un ProductVariant
  INGREDIENTE_COMPUESTO // ej. jarabe casero, usado dentro de otras recetas
}

enum RoleName {
  ADMINISTRADOR
  GERENTE
  BARISTA
  AUXILIAR
}

// Catálogo abierto de permisos atómicos, para no hardcodear reglas de rol
// en código. Se asignan permisos a roles vía RolePermission.
enum Permission {
  VENTA_REALIZAR
  VENTA_CANCELAR
  DESCUENTO_APLICAR_CODIGO
  DESCUENTO_MANUAL
  PRECIO_MODIFICAR
  DESCUENTO_CODIGO_CREAR
  INVENTARIO_CONSULTAR
  INVENTARIO_AJUSTAR
  INVENTARIO_CREAR_ITEM
  PRODUCTO_CREAR
  RECETA_CREAR
  RECETA_MODIFICAR
  COMPRA_REGISTRAR
  ORDEN_COMPRA_CREAR
  DEVOLUCION_REALIZAR
  CAJA_ABRIR
  CAJA_CERRAR
  CAJA_CORTE_AUTORIZAR
  CAJA_CHICA_MODIFICAR
  EMPLEADO_CREAR
  EMPLEADO_MODIFICAR
  EMPLEADO_ELIMINAR
  REPORTE_UTILIDAD_VER
  REPORTE_UTILIDAD_CREAR
  REPORTE_INVENTARIO_VER
  REPORTE_INVENTARIO_CREAR
  ESTADISTICAS_GESTIONAR
  CLIENTE_CONFIGURAR
  ASISTENCIA_CHECAR
  MENU_CONSULTAR
  // Exclusivos de ADMINISTRADOR — ningún otro rol los recibe en el seed.
  SUCURSAL_GESTIONAR // crear, editar o cerrar sucursales
  REPORTE_CONSOLIDADO_VER // reportes agregados de TODAS las sucursales
  CONFIGURACION_SISTEMA_GESTIONAR // impuestos, día operativo, config global
}

enum MovementType {
  VENTA
  COMPRA
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
  MERMA
  AJUSTE_MANUAL
  MUESTRA_GRATIS
  CONTEO_FISICO_AJUSTE
}

enum ShiftType {
  MATUTINO
  VESPERTINO
}

enum ShiftStatus {
  ABIERTO
  CERRADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum CashMovementType {
  RETIRO
  INGRESO
}

enum SaleStatus {
  COMPLETADA
  CANCELADA
}

enum SaleOrderType {
  CONSUMO_LOCAL
  PARA_LLEVAR
  DOMICILIO
}

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
  PRECIO_FINAL // reemplaza el total de la venta por un monto final fijo
}

// Catálogo precargado de justificaciones para descuento manual (gerente).
enum ManualDiscountReason {
  GIVEAWAY
  CORTESIA
  DESCUENTO_EMPLEADO
  OTRO
}

enum StockLocationType {
  BODEGA_CENTRAL
  SUCURSAL
}

enum PhysicalCountStatus {
  ABIERTO
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
}

// El inventario sale de origen al pasar a EN_TRANSITO, pero no se suma al
// stock de destino hasta RECIBIDO. Mientras está EN_TRANSITO no cuenta como
// disponible en ninguna ubicación.
enum TransferStatus {
  ENVIADO
  EN_TRANSITO
  RECIBIDO
  CANCELADO
}

// QUITAR: se remueve un ingrediente que sí está en la receta base — no
// afecta el precio (la venta se cobra igual que la receta completa), pero
// sí se descuenta menos inventario.
// AUMENTAR: se sube la cantidad de un ingrediente que ya está en la receta
// base, más allá de lo que la receta define — sí afecta precio.
// AGREGAR_EXTRA: se agrega un ingrediente que NO forma parte de la receta
// base (ej. esencia de lavanda en un chai) — sí afecta precio.
enum IngredientAdjustmentType {
  QUITAR
  AUMENTAR
  AGREGAR_EXTRA
}

enum PurchaseOrderStatus {
  CREADA
  PROVEIDA
  PROVEIDA_PARCIALMENTE // terminal — no se reabre, ver flujo de recepción parcial
  CANCELADA
}

// =========================================================================
// SUCURSALES / UBICACIONES
// =========================================================================

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeBranches EmployeeBranch[]
  branchProducts   BranchProduct[]
  stockLocations   StockLocation[]
  shifts           Shift[]
  sales            Sale[]
  purchaseOrders   PurchaseOrder[]
  suppliers        Supplier[]
  movements        InventoryMovement[] @relation("MovementBranch")
  transfersOut     InventoryMovement[] @relation("TransferOutBranch")
  transfersIn      InventoryMovement[] @relation("TransferInBranch")
  physicalCounts   PhysicalCount[]

  @@map("branches")
}

// Cada sucursal tiene su propia ubicación de stock; además existe UNA
// ubicación tipo BODEGA_CENTRAL (branchId nulo) que surte a las sucursales.
model StockLocation {
  id       String            @id @default(cuid())
  type     StockLocationType
  name     String
  branchId String?
  branch   Branch?           @relation(fields: [branchId], references: [id])

  stocks    InventoryStock[]
  batches   IngredientBatch[]
  movements InventoryMovement[]
  transfersOut TransferManifest[] @relation("TransferOrigin")
  transfersIn  TransferManifest[] @relation("TransferDestination")
  reorderPoints ReorderPoint[]

  @@map("stock_locations")
}

// =========================================================================
// INGREDIENTES / INSUMOS
// =========================================================================

model Ingredient {
  id                String             @id @default(cuid())
  name              String
  category          IngredientCategory
  kind              IngredientKind     @default(ATOMICO)
  baseUnit          UnitOfMeasure // unidad en la que se descuenta del inventario
  purchaseUnit      UnitOfMeasure // unidad en la que normalmente se compra
  tracksExpiration  Boolean            @default(true)
  isActive          Boolean            @default(true)
  // Precio de venta al cliente por unidad de baseUnit, cuando este
  // ingrediente se agrega como AGREGAR_EXTRA (fuera de la receta base) o
  // AUMENTAR (más allá de la cantidad definida por la receta). Distinto del
  // costo de proveedor — este es lo que se le cobra al cliente.
  extraUnitPrice    Decimal?           @db.Decimal(10, 2)
  // Días de anticipación con que se dispara la alerta de caducidad próxima
  // para este ingrediente. Varía por tipo — ej. leche 5 días, jarabe 30 días.
  expirationAlertDays Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  suppliers          IngredientSupplier[]
  batches            IngredientBatch[]
  stocks             InventoryStock[]
  recipeItems        RecipeIngredient[]
  modifierOptions    ModifierOption[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  physicalCountLines PhysicalCountLine[]
  transferLines      TransferLine[]
  saleAdjustments    SaleItemIngredientAdjustment[]
  costHistory        IngredientCostHistory[]
  reorderPoints      ReorderPoint[]

  @@map("ingredients")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // null = proveedor global (disponible para todas las sucursales).
  // Si tiene valor, es un proveedor local exclusivo de esa sucursal.
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  // Mínimo total de la orden en $, cuando el proveedor lo maneja así.
  // Independiente de IngredientSupplier.minOrderQuantity — un proveedor
  // puede tener uno, otro, ambos o ninguno.
  minOrderAmount Decimal? @db.Decimal(10, 2)

  // Días de la semana en que el proveedor acepta pedidos (0 = domingo ...
  // 6 = sábado). Usado para sugerir el día en que conviene mandar la orden.
  orderDays Int[]

  ingredientLinks IngredientSupplier[]
  purchaseOrders  PurchaseOrder[]

  @@map("suppliers")
}

// Un ingrediente puede tener varios proveedores, cada uno con su propio
// costo. `isSelected` marca cuál costo se usa para calcular costo de receta.
model IngredientSupplier {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  cost         Decimal    @db.Decimal(10, 4)
  costUnit     UnitOfMeasure
  isSelected   Boolean    @default(false) // costo "activo" para cálculo
  updatedAt    DateTime   @updatedAt

  // Mínimo de pedido para este ingrediente en particular con este
  // proveedor, cuando aplica (ej. "café: mínimo 20kg"). Independiente de
  // Supplier.minOrderAmount.
  minOrderQuantity Decimal?       @db.Decimal(12, 4)
  minOrderUnit     UnitOfMeasure?

  costHistory IngredientCostHistory[]

  @@unique([ingredientId, supplierId])
  @@map("ingredient_suppliers")
}

// Se inserta un registro cada vez que cambia `IngredientSupplier.cost` (ej.
// al registrar una entrada de inventario con un costo distinto al
// registrado) — en vez de solo sobrescribir, para reportes de "cuánto ha
// subido este insumo" y como disparador de recálculo de costo de recetas.
model IngredientCostHistory {
  id                   String              @id @default(cuid())
  ingredientId         String
  ingredient           Ingredient          @relation(fields: [ingredientId], references: [id])
  ingredientSupplierId String
  ingredientSupplier   IngredientSupplier  @relation(fields: [ingredientSupplierId], references: [id])
  previousCost         Decimal?            @db.Decimal(10, 4)
  newCost              Decimal             @db.Decimal(10, 4)
  costUnit             UnitOfMeasure
  changedAt            DateTime            @default(now())
  source               String? // ej. "entrada de inventario #123"

  @@map("ingredient_cost_history")
}

// Lotes por caducidad — el saldo agregado vive en InventoryStock; el lote
// permite trazabilidad y alertas de caducidad.
model IngredientBatch {
  id              String        @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4)
  unit            UnitOfMeasure
  expirationDate  DateTime?
  receivedAt      DateTime      @default(now())
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("ingredient_batches")
}

// Saldo agregado por ingrediente + ubicación (bodega central o sucursal).
model InventoryStock {
  id              String        @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4) // siempre en Ingredient.baseUnit
  updatedAt       DateTime      @updatedAt

  @@unique([ingredientId, stockLocationId])
  @@map("inventory_stocks")
}

// Registro de conversión entre unidades (ej. 1 L = 1000 ML, 1 espresso = 18 G)
model UnitConversion {
  id       String        @id @default(cuid())
  fromUnit UnitOfMeasure
  toUnit   UnitOfMeasure
  factor   Decimal       @db.Decimal(12, 6) // multiplicar fromUnit * factor = toUnit

  @@unique([fromUnit, toUnit])
  @@map("unit_conversions")
}

// =========================================================================
// PRODUCTOS / VARIANTES / RECETAS
// =========================================================================

model ProductCategory {
  id       String            @id @default(cuid())
  name     String            @unique // ej. "Café caliente", "Café frío", "Sin café", "Cafe de expendio"
  products Product[]

  @@map("product_categories")
}

model Product {
  id         String          @id @default(cuid())
  name       String // ej. "Latte", "Capuccino", "Cold Brew"
  imageUrl   String? // URL externa — no hay storage de archivos configurado
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  type       ProductType     @default(RECETA)
  isActive   Boolean         @default(true)
  // true  -> perecedero: al cancelar una venta ya cobrada, el inventario NO
  //          se reintegra, se registra como pérdida (ej. bebidas, postres,
  //          café en grano). Requiere autorización de gerente + justificación.
  // false -> no perecedero: al cancelar, el inventario SÍ se reintegra
  //          automáticamente (ej. merch, tazas). No requiere autorización.
  // Es un flag explícito y no se infiere de `type` porque hay productos de
  // REVENTA_DIRECTA que también son perecederos (café en grano, postres).
  isPerishable Boolean       @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  variants       ProductVariant[]
  branchProducts BranchProduct[]
  comboItems     ComboItem[]

  @@map("products")
}

// Tamaño / variante — cada variante tiene su propia receta independiente.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String // ej. "Chico", "Mediano", "Grande", "Único", "Por Kilo"
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)

  // Costo de producción calculado en el momento en que se fijó/revisó
  // `price` por última vez. Se compara contra el costo actual calculado de
  // la receta activa; si el costo actual sube más de 20% sobre este valor,
  // se dispara la alerta de "margen afectado". Se actualiza cuando el
  // gerente ajusta el precio o descarta la alerta.
  costAtLastPriceReview Decimal? @db.Decimal(10, 2)

  recipes         Recipe[]
  modifierGroups  VariantModifierGroup[]
  saleItems       SaleItem[]
  comboItems      ComboItem[]

  @@map("product_variants")
}

// Disponibilidad de producto por sucursal — cada sucursal puede tener su
// propio subconjunto de catálogo, y se puede marcar inactivo/agotado sin
// borrar del catálogo global.
model BranchProduct {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  isActive  Boolean @default(true) // agotado / fuera de temporada en esa sucursal

  @@unique([branchId, productId])
  @@map("branch_products")
}

// Receta versionada — cada cambio genera una nueva versión, preservando
// historial para costeo retroactivo de ventas pasadas.
model Recipe {
  id               String          @id @default(cuid())
  kind             RecipeKind      @default(PRODUCTO_VENDIBLE)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  // Cuando kind = INGREDIENTE_COMPUESTO, esta receta representa cómo se
  // arma un ingrediente compuesto (ej. jarabe casero) y no se liga a un
  // ProductVariant sino que se referencia desde RecipeIngredient.composedById
  name             String? // requerido cuando kind = INGREDIENTE_COMPUESTO

  versions RecipeVersion[]
  usedAsComposedIngredientIn RecipeIngredient[] @relation("ComposedIngredientUsage")

  @@map("recipes")
}

model RecipeVersion {
  id           String    @id @default(cuid())
  recipeId     String
  recipe       Recipe    @relation(fields: [recipeId], references: [id])
  versionNumber Int
  isActive     Boolean   @default(true) // sólo una versión activa a la vez por Recipe
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  notes        String? // ej. "cambio de marca de jarabe", "ajuste sin azúcar"

  ingredients RecipeIngredient[]
  saleItems   SaleItem[] // referencia a qué versión se usó al momento de la venta
  costHistory RecipeCostHistory[]

  @@unique([recipeId, versionNumber])
  @@map("recipe_versions")
}

// Snapshot del costo total calculado de una RecipeVersion en un momento
// dado. Se inserta cuando el costo cambia de forma significativa (ej. tras
// un IngredientCostHistory) y sirve tanto para reportes históricos de costo
// como para saber exactamente cuánto costaba producir la bebida en la fecha
// de una venta específica.
model RecipeCostHistory {
  id              String        @id @default(cuid())
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id])
  totalCost       Decimal       @db.Decimal(10, 2)
  recordedAt      DateTime      @default(now())
  reason          String? // ej. "cambio de costo de Café en grano", "snapshot de venta"

  @@map("recipe_cost_history")
}

// Una línea de receta consume exactamente UNO de los dos:
//   - un Ingredient atómico (ingredientId), o
//   - un Recipe de tipo INGREDIENTE_COMPUESTO (composedRecipeId), ej. un
//     jarabe casero que a su vez tiene su propia RecipeVersion con
//     ingredientes atómicos.
// Regla de negocio (no forzable nativamente en Prisma): exactamente uno de
// ingredientId / composedRecipeId debe estar presente. Validar en app o
// agregar un CHECK constraint vía migración SQL manual.
// COSTO: no se almacena costo fijo en ningún lado. Se calcula SIEMPRE de
// forma recursiva y automática en tiempo de consulta:
//   costo(RecipeIngredient) =
//     si ingredientId      -> quantity * IngredientSupplier.cost (isSelected=true)
//     si composedRecipeId  -> quantity * (suma recursiva del costo de la
//                              RecipeVersion activa de esa Recipe compuesta)
// Esto asegura que el costo de un jarabe casero siempre refleje el costo
// actual de sus insumos atómicos, sin mantenimiento manual. La app debe
// prevenir ciclos (Receta A compuesta de B y B compuesta de A) al guardar,
// ya que el schema no lo puede restringir.
model RecipeIngredient {
  id              String        @id @default(cuid())
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id])

  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])

  composedRecipeId String?
  composedRecipe   Recipe? @relation("ComposedIngredientUsage", fields: [composedRecipeId], references: [id])

  quantity Decimal       @db.Decimal(12, 4)
  unit     UnitOfMeasure

  @@map("recipe_ingredients")
}

// =========================================================================
// MODIFICADORES / EXTRAS
// =========================================================================

// Grupo de modificadores aplicable a una variante (ej. "Tipo de leche",
// "Shots extra", "Jarabe adicional").
model VariantModifierGroup {
  id               String         @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  name             String
  isRequired       Boolean        @default(false)
  allowMultiple    Boolean        @default(false)

  options ModifierOption[]

  @@map("variant_modifier_groups")
}

// Cada opción puede descontar inventario de un ingrediente específico
// (ej. "Shot extra" -> +1 ESPRESSO_SHOT de café; "Leche deslactosada" ->
// sustituye el ingrediente leche).
model ModifierOption {
  id                     String                @id @default(cuid())
  groupId                String
  group                  VariantModifierGroup  @relation(fields: [groupId], references: [id])
  name                   String // ej. "Shot extra", "Leche deslactosada", "Doble carga de chai"
  priceDelta             Decimal               @default(0) @db.Decimal(10, 2)
  ingredientId           String?
  ingredient             Ingredient?           @relation(fields: [ingredientId], references: [id])
  quantityDelta          Decimal?              @db.Decimal(12, 4) // cantidad a sumar/restar del ingrediente
  unit                   UnitOfMeasure?
  isSubstitution         Boolean               @default(false) // true = reemplaza ingrediente base en vez de sumar

  saleItemModifiers SaleItemModifier[]

  @@map("modifier_options")
}

// =========================================================================
// COMBOS
// =========================================================================

model Combo {
  id        String      @id @default(cuid())
  name      String
  price     Decimal     @db.Decimal(10, 2) // precio único del combo (utilidad se calcula agregada)
  isActive  Boolean     @default(true)

  items     ComboItem[]
  saleItems SaleItem[]

  @@map("combos")
}

model ComboItem {
  id               String          @id @default(cuid())
  comboId          String
  combo            Combo           @relation(fields: [comboId], references: [id])
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String
  productVariant   ProductVariant  @relation(fields: [productVariantId], references: [id])
  quantity         Int             @default(1)

  @@map("combo_items")
}

// =========================================================================
// USUARIOS / ROLES / PERMISOS
// =========================================================================

model Employee {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  pin          String? // login por PIN, alternativa a password
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches           EmployeeBranch[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  cashiersShifts     Shift[]              @relation("ShiftCashier")
  shiftsOpeningConfirmed Shift[]          @relation("ShiftOpeningConfirmedBy")
  shiftsClosingConfirmed Shift[]          @relation("ShiftClosingConfirmedBy")
  cashMovements      CashMovement[]
  purchaseOrders     PurchaseOrder[]
  physicalCounts     PhysicalCount[]      @relation("CountPerformedBy")
  approvedCounts     PhysicalCount[]      @relation("CountApprovedBy")
  manualDiscountsAuthorized ManualDiscount[] @relation("ManualDiscountAuthorizedBy")
  transfersInitiated TransferManifest[]   @relation("TransferInitiatedBy")
  transfersReceived  TransferManifest[]   @relation("TransferReceivedBy")

  @@map("employees")
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique

  permissions      RolePermission[]
  employeeBranches EmployeeBranch[]

  @@map("roles")
}

model RolePermission {
  id         String     @id @default(cuid())
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission

  @@unique([roleId, permission])
  @@map("role_permissions")
}

// Un empleado puede trabajar en varias sucursales, con distinto rol en
// cada una (empleado por sucursal por defecto, pero soporta multi-sucursal).
model EmployeeBranch {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  isPrimary  Boolean  @default(true) // sucursal "base" del empleado
  // Designación de "cajero", activable/desactivable independientemente del
  // rol (aplica tanto a BARISTA como a GERENTE). Un empleado solo puede ser
  // asignado como Shift.cashierId en esa sucursal si isCashier = true.
  isCashier  Boolean  @default(false)

  permissionOverrides EmployeePermissionOverride[]

  @@unique([employeeId, branchId])
  @@map("employee_branches")
}

// Excepción de permiso para un empleado en una sucursal específica.
// isGranted = true  -> otorga un permiso que su rol NO tiene por defecto
// isGranted = false -> revoca un permiso que su rol SÍ tiene por defecto
// El permiso "efectivo" de un empleado = permisos del Role, aplicando
// estas excepciones encima (override gana siempre sobre el rol).
model EmployeePermissionOverride {
  id               String         @id @default(cuid())
  employeeBranchId String
  employeeBranch   EmployeeBranch @relation(fields: [employeeBranchId], references: [id])
  permission       Permission
  isGranted        Boolean
  notes            String?
  createdAt        DateTime       @default(now())

  @@unique([employeeBranchId, permission])
  @@map("employee_permission_overrides")
}

// =========================================================================
// MOVIMIENTOS DE INVENTARIO / CONTEOS FÍSICOS
// =========================================================================

model InventoryMovement {
  id              String        @id @default(cuid())
  type            MovementType
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4) // positivo = entrada, negativo = salida
  unit            UnitOfMeasure

  branchId String?
  branch   Branch? @relation("MovementBranch", fields: [branchId], references: [id])

  // Sólo aplica para TRANSFERENCIA_* — referencia a sucursal origen/destino
  transferFromBranchId String?
  transferFromBranch   Branch? @relation("TransferOutBranch", fields: [transferFromBranchId], references: [id])
  transferToBranchId   String?
  transferToBranch     Branch? @relation("TransferInBranch", fields: [transferToBranchId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String?
  shift      Shift?   @relation(fields: [shiftId], references: [id])

  relatedSaleItemId String?
  saleItem          SaleItem? @relation(fields: [relatedSaleItemId], references: [id])

  // Presente cuando type = TRANSFERENCIA_SALIDA/ENTRADA — liga el movimiento
  // a la línea de TransferManifest que lo generó.
  transferLineId String?
  transferLine   TransferLine? @relation(fields: [transferLineId], references: [id])

  notes     String?
  createdAt DateTime @default(now())

  @@map("inventory_movements")
}

model PhysicalCount {
  id          String              @id @default(cuid())
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  status      PhysicalCountStatus @default(ABIERTO)
  performedById String
  performedBy   Employee          @relation("CountPerformedBy", fields: [performedById], references: [id])
  approvedById  String?
  approvedBy    Employee?         @relation("CountApprovedBy", fields: [approvedById], references: [id])
  startedAt   DateTime            @default(now())
  closedAt    DateTime?

  lines PhysicalCountLine[]

  @@map("physical_counts")
}

model PhysicalCountLine {
  id              String        @id @default(cuid())
  physicalCountId String
  physicalCount   PhysicalCount @relation(fields: [physicalCountId], references: [id])
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  theoreticalQty  Decimal       @db.Decimal(12, 4) // congelado al momento del conteo
  physicalQty     Decimal       @db.Decimal(12, 4)
  unit            UnitOfMeasure

  @@map("physical_count_lines")
}

// La inicia administración (fromStockLocation típicamente BODEGA_CENTRAL,
// aunque también soporta sucursal-a-sucursal), la recibe gerente o barista
// delegado en destino. El movimiento de inventario real (InventoryMovement,
// tipo TRANSFERENCIA_SALIDA / TRANSFERENCIA_ENTRADA) se genera en cada
// transición de estado, ligado vía TransferLine.
model TransferManifest {
  id     String @id @default(cuid())
  status TransferStatus @default(ENVIADO)

  fromStockLocationId String
  fromStockLocation   StockLocation @relation("TransferOrigin", fields: [fromStockLocationId], references: [id])
  toStockLocationId    String
  toStockLocation      StockLocation @relation("TransferDestination", fields: [toStockLocationId], references: [id])

  initiatedById String
  initiatedBy   Employee  @relation("TransferInitiatedBy", fields: [initiatedById], references: [id])
  receivedById  String?
  receivedBy    Employee? @relation("TransferReceivedBy", fields: [receivedById], references: [id])

  sentAt       DateTime  @default(now())
  inTransitAt  DateTime?
  receivedAt   DateTime?
  notes        String?

  lines TransferLine[]

  @@map("transfer_manifests")
}

model TransferLine {
  id                 String           @id @default(cuid())
  transferManifestId String
  transferManifest   TransferManifest @relation(fields: [transferManifestId], references: [id])
  ingredientId       String
  ingredient         Ingredient       @relation(fields: [ingredientId], references: [id])
  quantity           Decimal          @db.Decimal(12, 4) // cantidad enviada
  unit               UnitOfMeasure

  // Si lo recibido no coincide con lo enviado (ej. se rompió en el camino),
  // se captura aquí y el sistema genera automáticamente un InventoryMovement
  // tipo MERMA por la diferencia, con nota visible en la auditoría de la
  // sucursal receptora. receivedQuantity = quantity si no hubo discrepancia.
  receivedQuantity   Decimal?         @db.Decimal(12, 4)
  discrepancyNote    String?

  movements InventoryMovement[]

  @@map("transfer_lines")
}

// =========================================================================
// COMPRAS
// =========================================================================

// Punto de reorden por ingrediente + ubicación de stock (distinto del
// bloqueo de venta de Fase 1, que se calcula contra el máximo de las
// recetas activas). manualThreshold lo define el usuario; la sugerencia
// dinámica basada en consumo de los últimos 15 días se calcula en query
// time contra InventoryMovement (type = VENTA), no se persiste aquí.
model ReorderPoint {
  id              String        @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  manualThreshold Decimal       @db.Decimal(12, 4)
  unit            UnitOfMeasure
  updatedAt       DateTime      @updatedAt

  @@unique([ingredientId, stockLocationId])
  @@map("reorder_points")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id])
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  employeeId String
  employee   Employee            @relation(fields: [employeeId], references: [id])
  status     PurchaseOrderStatus @default(CREADA)
  createdAt  DateTime            @default(now())
  receivedAt DateTime?

  // Fecha en que se marcó como pagada (captura manual). Se compara contra
  // createdAt para medir cuántos días tarda el proveedor en surtir.
  paidAt     DateTime?

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])

  orderedQuantity  Decimal        @db.Decimal(12, 4)
  // null hasta que se registra la recepción; permite recepción parcial
  // (orderedQuantity - receivedQuantity = pendiente).
  receivedQuantity Decimal?       @db.Decimal(12, 4)
  unit             UnitOfMeasure

  estimatedUnitCost Decimal        @db.Decimal(10, 4)
  // capturado al recibir, para ver variación estimado vs. real
  actualUnitCost    Decimal?       @db.Decimal(10, 4)

  batches IngredientBatch[]

  @@map("purchase_order_items")
}

// =========================================================================
// CAJA / TURNOS
// =========================================================================

model Shift {
  id         String      @id @default(cuid())
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id])
  type       ShiftType
  status     ShiftStatus @default(ABIERTO)
  cashierId  String
  cashier    Employee    @relation("ShiftCashier", fields: [cashierId], references: [id])

  // Confirmación de apertura: preferentemente gerente, pero puede ser
  // cualquier otro empleado (distinto del cajero) si el gerente no está
  // disponible por incapacidad, día libre, u otra diligencia.
  openingConfirmedById String?
  openingConfirmedBy   Employee? @relation("ShiftOpeningConfirmedBy", fields: [openingConfirmedById], references: [id])
  openingConfirmedAt   DateTime?

  openedAt   DateTime    @default(now())
  closedAt   DateTime?
  openingCash  Decimal   @default(0) @db.Decimal(10, 2)
  closingCash  Decimal?  @db.Decimal(10, 2) // conteo físico al corte

  // Total esperado (apertura + ventas efectivo - retiros + ingresos),
  // calculado SOLO al momento del corte, nunca en tiempo real.
  expectedCash     Decimal? @db.Decimal(10, 2)
  // closingCash - expectedCash. Si no es 0, se requiere differenceReason.
  cashDifference   Decimal? @db.Decimal(10, 2)
  differenceReason String?

  // El turno no puede pasar a CERRADO hasta que ambas confirmaciones existan
  // (evidencia de doble firma). closingConfirmedBy sigue el mismo criterio
  // de flexibilidad que openingConfirmedBy: gerente de preferencia, o
  // cualquier otro empleado si no está disponible.
  cashierConfirmedAt   DateTime?
  closingConfirmedById String?
  closingConfirmedBy   Employee? @relation("ShiftClosingConfirmedBy", fields: [closingConfirmedById], references: [id])
  closingConfirmedAt   DateTime?

  sales               Sale[]
  cashMovements       CashMovement[]
  inventoryMovements  InventoryMovement[]

  @@map("shifts")
}

model CashMovement {
  id         String            @id @default(cuid())
  shiftId    String
  shift      Shift             @relation(fields: [shiftId], references: [id])
  type       CashMovementType
  amount     Decimal           @db.Decimal(10, 2)
  reason     String // ej. "compra de hielo"
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id])
  createdAt  DateTime          @default(now())

  @@map("cash_movements")
}

// =========================================================================
// CLIENTES / LEALTAD
// =========================================================================

model Customer {
  id        String    @id @default(cuid())
  name      String
  birthDate DateTime?
  email     String?   @unique
  phone     String?   @unique
  createdAt DateTime  @default(now())

  loyaltyCard LoyaltyCard?
  sales       Sale[]

  @@map("customers")
}

model LoyaltyCard {
  id         String       @id @default(cuid())
  customerId String       @unique
  customer   Customer     @relation(fields: [customerId], references: [id])
  stamps     Int          @default(0) // sellos acumulados, reinician cada 5
  tierId     String?
  tier       LoyaltyTier? @relation(fields: [tierId], references: [id])
  createdAt  DateTime     @default(now())

  @@map("loyalty_cards")
}

model LoyaltyTier {
  id               String   @id @default(cuid())
  name             String   @unique
  minLifetimeStamps Int // umbral acumulado histórico para alcanzar el nivel
  benefits         String?

  cards LoyaltyCard[]

  @@map("loyalty_tiers")
}

// =========================================================================
// VENTAS
// =========================================================================

model Sale {
  id         String     @id @default(cuid())
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id])
  shiftId    String
  shift      Shift      @relation(fields: [shiftId], references: [id])
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id])
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  status     SaleStatus @default(COMPLETADA)
  orderType  SaleOrderType @default(PARA_LLEVAR)
  subtotal   Decimal    @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal    @db.Decimal(10, 2) // IVA incluido
  createdAt  DateTime   @default(now())
  cancelledAt DateTime?
  cancelledById String?

  items       SaleItem[]
  payments    SalePayment[]
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountCodeId String?
  manualDiscount ManualDiscount?

  @@map("sales")
}

model SaleItem {
  id               String          @id @default(cuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  comboId          String?
  combo            Combo?          @relation(fields: [comboId], references: [id])
  recipeVersionId  String? // snapshot de qué versión de receta se usó
  recipeVersion    RecipeVersion?  @relation(fields: [recipeVersionId], references: [id])
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(10, 2)
  lineTotal        Decimal         @db.Decimal(10, 2)
  notes            String? // ej. "sin azúcar", "bien caliente"

  modifiers           SaleItemModifier[]
  ingredientAdjustments SaleItemIngredientAdjustment[]
  inventoryMovements  InventoryMovement[]

  @@map("sale_items")
}

// Ajustes libres a nivel de ingrediente sobre la receta base de una línea
// de venta (más allá de los ModifierOption curados). QUITAR no afecta
// precio; AUMENTAR y AGREGAR_EXTRA sí, vía priceDelta calculado con
// Ingredient.extraUnitPrice * quantity.
model SaleItemIngredientAdjustment {
  id           String                   @id @default(cuid())
  saleItemId   String
  saleItem     SaleItem                 @relation(fields: [saleItemId], references: [id])
  ingredientId String
  ingredient   Ingredient               @relation(fields: [ingredientId], references: [id])
  type         IngredientAdjustmentType
  quantity     Decimal                  @db.Decimal(12, 4)
  unit         UnitOfMeasure
  priceDelta   Decimal                  @default(0) @db.Decimal(10, 2)

  @@map("sale_item_ingredient_adjustments")
}

model SaleItemModifier {
  id                 String         @id @default(cuid())
  saleItemId         String
  saleItem           SaleItem       @relation(fields: [saleItemId], references: [id])
  modifierOptionId   String
  modifierOption     ModifierOption @relation(fields: [modifierOptionId], references: [id])
  priceDelta         Decimal        @db.Decimal(10, 2)

  @@map("sale_item_modifiers")
}

model SalePayment {
  id     String        @id @default(cuid())
  saleId String
  sale   Sale          @relation(fields: [saleId], references: [id])
  method PaymentMethod
  amount Decimal       @db.Decimal(10, 2)

  @@map("sale_payments")
}

model DiscountCode {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  isActive  Boolean      @default(true)
  expiresAt DateTime?

  sales Sale[]

  @@map("discount_codes")
}

// Descuento manual autorizado por gerente (PIN/contraseña), independiente
// del flujo de DiscountCode escaneado. type determina cómo se interpreta
// value: PORCENTAJE (%), MONTO_FIJO (se resta del total), o PRECIO_FINAL
// (reemplaza el total de la venta). Aparece en el ticket como "descuento
// aprobado por gerente" junto con `reason`.
model ManualDiscount {
  id             String               @id @default(cuid())
  saleId         String               @unique
  sale           Sale                 @relation(fields: [saleId], references: [id])
  type           DiscountType
  value          Decimal              @db.Decimal(10, 2)
  reason         ManualDiscountReason
  authorizedById String
  authorizedBy   Employee             @relation("ManualDiscountAuthorizedBy", fields: [authorizedById], references: [id])
  createdAt      DateTime             @default(now())

  @@map("manual_discounts")
}
