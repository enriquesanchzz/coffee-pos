// =========================================================================
// Nomada Café POS — Fase 0
// Schema base derivado de ADR-001 + Respuestas Fase 0 (modelo de datos)
// =========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UnitOfMeasure {
  KG // kilogramo
  G // gramo
  L // litro
  ML // mililitro
  PUMP // pump de jarabe
  PIEZA // unidad/pieza
  CUCHARADA // cucharada (topping)
  ESPRESSO_SHOT // unidad de espresso (18g)
}

enum IngredientKind {
  ATOMICO // se compra directo a proveedor
  COMPUESTO // se arma con otros ingredientes vía Recipe, pero no se
  // descuenta directo del inventario — ver Recipe.kind = COMPUESTO
}

enum LoyaltyMode {
  SEPARADO
  GLOBAL
}

enum LoyaltyProgram {
  CAFE
  PET_SHOP
  GLOBAL
}

enum LoyaltyRewardType {
  NINGUNA
  CUPON_PORCENTAJE
  PRODUCTO_GRATIS
  DESCUENTO_PERMANENTE
}

enum LoyaltyEntryReason {
  VENTA
  CANCELACION
  CONVERSION
  REINICIO
}

enum BusinessUnit {
  CAFE
  PET_SHOP
}

enum ProductType {
  RECETA // pasa por el modelo de receta/inventario por ingrediente
  REVENTA_DIRECTA // ej. merch, café en bolsa, postres, bebidas de aparador
}

enum RecipeKind {
  PRODUCTO_VENDIBLE // receta final de un ProductVariant
  INGREDIENTE_COMPUESTO // ej. jarabe casero, usado dentro de otras recetas
}

enum RoleName {
  ADMINISTRADOR
  GERENTE
  BARISTA
  AUXILIAR
}

// Catálogo abierto de permisos atómicos, para no hardcodear reglas de rol
// en código. Se asignan permisos a roles vía RolePermission.
enum Permission {
  VENTA_REALIZAR
  VENTA_CANCELAR
  DESCUENTO_APLICAR_CODIGO
  DESCUENTO_MANUAL
  PRECIO_MODIFICAR
  DESCUENTO_CODIGO_CREAR
  INVENTARIO_CONSULTAR
  INVENTARIO_AJUSTAR
  INVENTARIO_CREAR_ITEM
  PRODUCTO_CREAR
  RECETA_CREAR
  RECETA_MODIFICAR
  COMPRA_REGISTRAR
  ORDEN_COMPRA_CREAR
  DEVOLUCION_REALIZAR
  CAJA_ABRIR
  CAJA_CERRAR
  CAJA_CORTE_AUTORIZAR
  CAJA_CHICA_MODIFICAR
  EMPLEADO_CREAR
  EMPLEADO_MODIFICAR
  EMPLEADO_ELIMINAR
  REPORTE_UTILIDAD_VER
  REPORTE_UTILIDAD_CREAR
  REPORTE_INVENTARIO_VER
  REPORTE_INVENTARIO_CREAR
  ESTADISTICAS_GESTIONAR
  CLIENTE_CONFIGURAR
  ASISTENCIA_CHECAR
  MENU_CONSULTAR
  PROMOCION_GESTIONAR
  // Exclusivos de ADMINISTRADOR — ningún otro rol los recibe en el seed.
  SUCURSAL_GESTIONAR // crear, editar o cerrar sucursales
  REPORTE_CONSOLIDADO_VER // reportes agregados de TODAS las sucursales
  CONFIGURACION_SISTEMA_GESTIONAR // impuestos, día operativo, config global
}

enum MovementType {
  VENTA
  COMPRA
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
  MERMA
  AJUSTE_MANUAL
  MUESTRA_GRATIS
  CONTEO_FISICO_AJUSTE
}

enum ShiftType {
  MATUTINO
  VESPERTINO
}

enum ShiftStatus {
  ABIERTO
  CERRADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum CashMovementType {
  RETIRO
  INGRESO
}

enum SaleStatus {
  COMPLETADA
  CANCELADA
  // Cuenta de Mesa dejada abierta a propósito (ver Sale.tableNumber) — ya
  // tiene items con inventario descontado, pero todavía no se cobra ni
  // tiene SalePayment. Se cierra vía closeTab() (actions/pos.ts), que la
  // pasa a COMPLETADA.
  ABIERTA
}

enum SaleOrderType {
  CONSUMO_LOCAL
  PARA_LLEVAR
  DOMICILIO
}

// Solo aplica cuando SaleOrderType = DOMICILIO — cómo llegó el pedido.
enum DomicilioOrigen {
  TELEFONO
  APP
}

// Eje de temperatura de una variante de bebida (ver ProductVariant.temperature).
enum VariantTemperature {
  CALIENTE
  FRIO
  FRAPPE
}

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
  PRECIO_FINAL // reemplaza el total de la venta por un monto final fijo
}

// Subcategoría de DiscountCode para el módulo Promociones (nuevo menú,
// separado de Clientes) — nullable porque los códigos ya sembrados antes
// de este campo (ej. cupones de bienvenida) no tienen categoría hasta que
// alguien la asigne desde /descuentos.
enum DiscountCodeCategory {
  CLIENTE_ESPECIFICO
  CAMPANA
  EMPLEADO
}

// Catálogo precargado de justificaciones para descuento manual (gerente).
enum ManualDiscountReason {
  GIVEAWAY
  CORTESIA
  DESCUENTO_EMPLEADO
  OTRO
}

enum StockLocationType {
  BODEGA_CENTRAL
  SUCURSAL
}

enum PhysicalCountStatus {
  ABIERTO
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
}

// El inventario sale de origen al pasar a EN_TRANSITO, pero no se suma al
// stock de destino hasta RECIBIDO. Mientras está EN_TRANSITO no cuenta como
// disponible en ninguna ubicación.
enum TransferStatus {
  ENVIADO
  EN_TRANSITO
  RECIBIDO
  CANCELADO
}

// QUITAR: se remueve un ingrediente que sí está en la receta base — no
// afecta el precio (la venta se cobra igual que la receta completa), pero
// sí se descuenta menos inventario.
// AUMENTAR: se sube la cantidad de un ingrediente que ya está en la receta
// base, más allá de lo que la receta define — sí afecta precio.
// AGREGAR_EXTRA: se agrega un ingrediente que NO forma parte de la receta
// base (ej. esencia de lavanda en un chai) — sí afecta precio.
enum IngredientAdjustmentType {
  QUITAR
  AUMENTAR
  AGREGAR_EXTRA
}

enum PurchaseOrderStatus {
  CREADA
  PROVEIDA
  PROVEIDA_PARCIALMENTE // terminal — no se reabre, ver flujo de recepción parcial
  CANCELADA
}

// =========================================================================
// SUCURSALES / UBICACIONES
// =========================================================================

model Branch {
  id                    String   @id @default(cuid())
  name                  String
  address               String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  // % de costo de alimentos objetivo para el precio sugerido al crear/
  // editar una receta (precio sugerido = costo ÷ este %) — ajustable
  // desde Administración, ver actions/settings.ts. null se trata como 30
  // (lib/recipes.ts getTargetFoodCostPercent).
  targetFoodCostPercent Decimal? @db.Decimal(5, 2)

  // Apariencia global del sistema, ajustable desde Administración
  // (ver lib/theme.ts y actions/settings.ts). Claves validadas en código,
  // no a nivel de columna — null se resuelve a los defaults de THEME_DEFAULTS.
  themeMode            String? // "claro" | "oscuro"
  themeColor           String? // hex "#RRGGBB" — acento (antes clave de paleta cerrada)
  themeBackgroundColor String? // hex "#RRGGBB", null = fondo por defecto de themeMode
  themeFontFamily      String? // "sans" | "rounded" | "serif"
  themeFontSize        String? // "sm" | "md" | "lg"

  // ---- Configuración del sistema (lib/settings.ts, actions/settings.ts) ----
  // Negocio. businessName null = "Nomada Café"; timeZone null = la de
  // NEXT_PUBLIC_APP_TIME_ZONE (o America/Mexico_City).
  businessName               String?
  phone                      String?
  timeZone                   String?
  // Datos fiscales y de marca para el ticket impreso — no se usan en
  // ningún otro lado del sistema (lib/receipt.ts).
  razonSocial                String? // nombre fiscal, si es distinto al comercial (businessName)
  rfc                        String?
  logoUrl                    String? // link https:// — no hay storage de archivos propio
  ticketFooterMessage        String? // ej. "¡Gracias por tu visita!" — null = frase por default
  ticketPromoMessage         String? // ej. "10% en tu próxima visita con este ticket"
  wifiNetwork                String?
  wifiPassword               String?
  // Cobro
  tipPercents                Int[]           @default([10, 15, 20])
  highTipThresholdPercent    Int             @default(50) // % del total arriba del cual se confirma la propina
  paymentMethods             PaymentMethod[] @default([EFECTIVO, TARJETA, TRANSFERENCIA])
  cashQuickBills             Int[]           @default([20, 50, 100, 200, 500, 1000])
  // Caja y turnos
  shiftChangeHour            Int             @default(14) // desde esta hora se sugiere VESPERTINO
  defaultOpeningCash         Decimal         @default(0) @db.Decimal(10, 2)
  cashDifferenceTolerance    Decimal         @default(0) @db.Decimal(10, 2) // diferencia de corte permitida sin motivo
  // Lealtad
  loyaltyStampsPerReward     Int             @default(5) // legado: sellos, reemplazado por puntos (ver LoyaltyBalance)
  // Lealtad por puntos (Configuración → Lealtad). Puntos por cada $100
  // cobrados (después de descuentos, sin propina) en cada negocio. En modo
  // SEPARADO cada negocio tiene su saldo y sus niveles; en GLOBAL se suman
  // en un solo saldo. Siempre se llevan los tres saldos (ver
  // lib/loyalty-points.ts), así cambiar de modo no pierde nada.
  loyaltyMode                LoyaltyMode     @default(SEPARADO)
  loyaltyPointsPer100Cafe    Int             @default(5)
  loyaltyPointsPer100PetShop Int             @default(1)
  // true = al llegar al último nivel los puntos vuelven a 0 (el excedente
  // se conserva) y los niveles se pueden volver a ganar. false = los
  // puntos se acumulan para siempre y el nivel es un estatus.
  loyaltyResetAtTopLevel     Boolean         @default(false)
  welcomeCouponPercent       Int             @default(10) // 0 = no se crea cupón de bienvenida
  welcomeCouponValidDays     Int? // null = sin vencimiento
  // Cupones de cumpleaños (lib/birthdays.ts): % para el cliente (en
  // Cafetería) y para su mascota (en Pet Shop, a nombre del dueño). 0 = no
  // se regala. Valen desde el día del cumpleaños durante N días.
  birthdayCustomerPercent    Int             @default(0)
  birthdayPetPercent         Int             @default(0)
  birthdayCouponValidDays    Int             @default(7)
  // Días que la fecha de cumpleaños debe llevar registrada antes del
  // festejo para dar cupón (anti-abuso). 0 = basta con que sea antes del día.
  birthdayLeadDays           Int             @default(30)
  // Recordatorios por WhatsApp (lib/reminders.ts, Clientes → Recordatorios).
  // Cafetería: "te extrañamos" a quien lleva N días sin comprar café.
  // Pet Shop: N días después de comprar un producto, salvo que el producto
  // tenga sus propios días/mensaje (Product.reminderDays/reminderMessage).
  // 0 días = apagado; mensaje null = el de lib/settings-shared.ts.
  reminderCafeDays           Int             @default(30)
  reminderCafeMessage        String?
  reminderPetShopDays        Int             @default(30)
  reminderPetShopMessage     String?
  // Descuentos: tope del descuento manual como % del subtotal (null = sin tope)
  maxManualDiscountPercent   Int?
  // Inventario: qué pasa al vender sin insumos suficientes
  // "CONFIRMAR" (cualquiera confirma) | "GERENTE" (solo quien tenga
  // INVENTARIO_AJUSTAR) | "BLOQUEAR" (nunca)
  shortagePolicy             String          @default("CONFIRMAR")
  // Seguridad
  pinMaxAttempts             Int             @default(5)
  pinLockMinutes             Int             @default(5)
  sessionHours               Int             @default(12)
  // Impuestos: "NINGUNO" | "INCLUIDO" (precios con IVA incluido; se desglosa)
  taxMode                    String          @default("NINGUNO")
  taxRatePercent             Decimal         @default(16) @db.Decimal(5, 2)

  employeeBranches EmployeeBranch[]
  branchProducts   BranchProduct[]
  stockLocations   StockLocation[]
  shifts           Shift[]
  sales            Sale[]
  purchaseOrders   PurchaseOrder[]
  suppliers        Supplier[]
  movements        InventoryMovement[] @relation("MovementBranch")
  transfersOut     InventoryMovement[] @relation("TransferOutBranch")
  transfersIn      InventoryMovement[] @relation("TransferInBranch")
  physicalCounts   PhysicalCount[]

  @@map("branches")
}

// Cada sucursal tiene su propia ubicación de stock; además existe UNA
// ubicación tipo BODEGA_CENTRAL (branchId nulo) que surte a las sucursales.
model StockLocation {
  id       String            @id @default(cuid())
  type     StockLocationType
  name     String
  branchId String?
  branch   Branch?           @relation(fields: [branchId], references: [id])

  stocks        InventoryStock[]
  batches       IngredientBatch[]
  movements     InventoryMovement[]
  transfersOut  TransferManifest[]  @relation("TransferOrigin")
  transfersIn   TransferManifest[]  @relation("TransferDestination")
  reorderPoints ReorderPoint[]

  @@map("stock_locations")
}

// =========================================================================
// INGREDIENTES / INSUMOS
// =========================================================================

// Antes un enum fijo (CAFE/JARABES/LECHE/TOPPINGS/INSUMOS) — se migró a
// tabla real (mismo patrón que ProductCategory) para poder crear/editar/
// borrar categorías de insumo desde /inventario, ver
// prisma/migrations/*_ingredient_category_to_table.
model IngredientCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  icon        String?
  ingredients Ingredient[]

  @@map("ingredient_categories")
}

model Ingredient {
  id                       String             @id @default(cuid())
  name                     String
  categoryId               String
  category                 IngredientCategory @relation(fields: [categoryId], references: [id])
  kind                     IngredientKind     @default(ATOMICO)
  baseUnit                 UnitOfMeasure // unidad en la que se descuenta del inventario
  purchaseUnit             UnitOfMeasure // unidad en la que normalmente se compra
  tracksExpiration         Boolean            @default(true)
  isActive                 Boolean            @default(true)
  // Precio de venta al cliente cuando este ingrediente se agrega como extra
  // libre en el POS ("Agregar otro ingrediente"), por cada unidad de
  // standardDoseUnit (o de baseUnit si no tiene dosis estándar) — ej.
  // $12 por shot. Distinto del costo de proveedor. null = se cobra el costo
  // cotizado ÷ el % de food cost objetivo (ver resolveSaleItems en
  // actions/pos.ts); antes se cobraba el costo tal cual, sin margen.
  extraUnitPrice           Decimal?           @db.Decimal(12, 4)
  // Días de anticipación con que se dispara la alerta de caducidad próxima
  // para este ingrediente. Varía por tipo — ej. leche 5 días, jarabe 30 días.
  expirationAlertDays      Int?
  // Si no es null, este ingrediente es un vaso/contenedor con esta
  // capacidad — createSale (actions/pos.ts) lo usa para elegir
  // automáticamente el vaso más chico que alcance según
  // ProductVariant.sizeOz, en vez de que la receta lo liste a mano.
  cupCapacityOz            Decimal?           @db.Decimal(6, 2)
  // Dosis estándar para capturar este ingrediente como línea de receta,
  // opción de modificador, o extra libre en el POS — evita pedir mililitros
  // crudos para cosas como "1 pump de vainilla" o "1 splash de leche".
  // Requiere un UnitConversion de standardDoseUnit → baseUnit para poder
  // convertir al costear/descontar inventario (mismo mecanismo que ya usa
  // toBaseUnit() en actions/pos.ts). null = se sigue capturando en baseUnit,
  // como antes.
  standardDoseQuantity     Decimal?           @db.Decimal(8, 2)
  standardDoseUnit         UnitOfMeasure?
  // Presentación en la que se compra (ej. "Caja 12 L" = 12000 ml). Las
  // órdenes de compra se capturan en esta presentación y se convierten a
  // baseUnit al guardarlas. null = se usa purchaseUnit con la conversión
  // estándar (L→ml, kg→g...) o, si no hay, baseUnit (ver lib/units.ts).
  purchasePresentationName String?
  purchasePresentationSize Decimal?           @db.Decimal(12, 4) // en baseUnit
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  suppliers          IngredientSupplier[]
  batches            IngredientBatch[]
  stocks             InventoryStock[]
  recipeItems        RecipeIngredient[]
  modifierOptions    ModifierOption[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  physicalCountLines PhysicalCountLine[]
  transferLines      TransferLine[]
  saleAdjustments    SaleItemIngredientAdjustment[]
  costHistory        IngredientCostHistory[]
  reorderPoints      ReorderPoint[]

  @@map("ingredients")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // null = proveedor global (disponible para todas las sucursales).
  // Si tiene valor, es un proveedor local exclusivo de esa sucursal.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Mínimo total de la orden en $, cuando el proveedor lo maneja así.
  // Independiente de IngredientSupplier.minOrderQuantity — un proveedor
  // puede tener uno, otro, ambos o ninguno.
  minOrderAmount Decimal? @db.Decimal(10, 2)

  // Días de la semana en que el proveedor acepta pedidos (0 = domingo ...
  // 6 = sábado). Usado para sugerir el día en que conviene mandar la orden.
  orderDays Int[]

  ingredientLinks IngredientSupplier[]
  purchaseOrders  PurchaseOrder[]

  @@map("suppliers")
}

// Un ingrediente puede tener varios proveedores, cada uno con su propio
// costo. `isSelected` marca cuál costo se usa para calcular costo de receta.
model IngredientSupplier {
  id           String        @id @default(cuid())
  ingredientId String
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  cost         Decimal       @db.Decimal(10, 4)
  costUnit     UnitOfMeasure
  isSelected   Boolean       @default(false) // costo "activo" para cálculo
  updatedAt    DateTime      @updatedAt

  // Mínimo de pedido para este ingrediente en particular con este
  // proveedor, cuando aplica (ej. "café: mínimo 20kg"). Independiente de
  // Supplier.minOrderAmount.
  minOrderQuantity Decimal?       @db.Decimal(12, 4)
  minOrderUnit     UnitOfMeasure?

  costHistory IngredientCostHistory[]

  @@unique([ingredientId, supplierId])
  @@map("ingredient_suppliers")
}

// Se inserta un registro cada vez que cambia `IngredientSupplier.cost` (ej.
// al registrar una entrada de inventario con un costo distinto al
// registrado) — en vez de solo sobrescribir, para reportes de "cuánto ha
// subido este insumo" y como disparador de recálculo de costo de recetas.
model IngredientCostHistory {
  id                   String             @id @default(cuid())
  ingredientId         String
  ingredient           Ingredient         @relation(fields: [ingredientId], references: [id])
  ingredientSupplierId String
  ingredientSupplier   IngredientSupplier @relation(fields: [ingredientSupplierId], references: [id])
  previousCost         Decimal?           @db.Decimal(10, 4)
  newCost              Decimal            @db.Decimal(10, 4)
  costUnit             UnitOfMeasure
  changedAt            DateTime           @default(now())
  source               String? // ej. "entrada de inventario #123"

  @@map("ingredient_cost_history")
}

// Lotes por caducidad — el saldo agregado vive en InventoryStock; el lote
// permite trazabilidad y alertas de caducidad.
model IngredientBatch {
  id                  String             @id @default(cuid())
  ingredientId        String
  ingredient          Ingredient         @relation(fields: [ingredientId], references: [id])
  stockLocationId     String
  stockLocation       StockLocation      @relation(fields: [stockLocationId], references: [id])
  quantity            Decimal            @db.Decimal(12, 4)
  unit                UnitOfMeasure
  expirationDate      DateTime?
  receivedAt          DateTime           @default(now())
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("ingredient_batches")
}

// Saldo agregado por ingrediente + ubicación (bodega central o sucursal).
model InventoryStock {
  id              String        @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4) // siempre en Ingredient.baseUnit
  updatedAt       DateTime      @updatedAt

  @@unique([ingredientId, stockLocationId])
  @@map("inventory_stocks")
}

// Registro de conversión entre unidades (ej. 1 L = 1000 ML, 1 espresso = 18 G)
model UnitConversion {
  id       String        @id @default(cuid())
  fromUnit UnitOfMeasure
  toUnit   UnitOfMeasure
  factor   Decimal       @db.Decimal(12, 6) // multiplicar fromUnit * factor = toUnit

  @@unique([fromUnit, toUnit])
  @@map("unit_conversions")
}

// =========================================================================
// PRODUCTOS / VARIANTES / RECETAS
// =========================================================================

// Árbol de 2 niveles: una categoría con parentId es "hija" (subcategoría).
// Los productos siempre cuelgan de la hoja (categoryId), nunca del padre
// directamente salvo que el padre no tenga hijas (ej. "Café en grano").
model ProductCategory {
  id           String            @id @default(cuid())
  name         String            @unique // ej. "Café caliente", "Café frío", "Sin café", "Cafe de expendio"
  // Nombre de ícono Lucide (ej. "Coffee", "Snowflake") — validado contra
  // una lista fija en components/productos/category-icon-picker.tsx, no
  // cualquier string. null = sin ícono (fallback visual genérico).
  icon         String?
  parentId     String?
  parent       ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  // Unidad de negocio (Cafetería / Pet Shop): base de la lealtad por
  // puntos, los cupones por unidad y el desglose de reportes. Se elige en
  // la categoría raíz; las subcategorías la heredan (actions/recipes.ts
  // updateProductCategory la propaga) para no tener que subir de nivel al
  // leerla.
  businessUnit BusinessUnit      @default(CAFE)
  children     ProductCategory[] @relation("CategoryHierarchy")
  products     Product[]

  @@map("product_categories")
}

model Product {
  id              String          @id @default(cuid())
  name            String // ej. "Latte", "Capuccino", "Cold Brew"
  imageUrl        String? // URL externa — no hay storage de archivos configurado
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  type            ProductType     @default(RECETA)
  isActive        Boolean         @default(true)
  // true  -> perecedero: al cancelar una venta ya cobrada, el inventario NO
  //          se reintegra, se registra como pérdida (ej. bebidas, postres,
  //          café en grano). Requiere autorización de gerente + justificación.
  // false -> no perecedero: al cancelar, el inventario SÍ se reintegra
  //          automáticamente (ej. merch, tazas). No requiere autorización.
  // Es un flag explícito y no se infiere de `type` porque hay productos de
  // REVENTA_DIRECTA que también son perecederos (café en grano, postres).
  isPerishable    Boolean         @default(true)
  // Lo que contiene, para las alertas de alergias de mascotas en el POS
  // (lib/allergens.ts), ej. ["pollo", "lácteos"].
  allergenTags    String[]        @default([])
  // Recordatorio de Pet Shop (lib/reminders.ts): null = el de
  // Configuración → Recordatorios; reminderDays 0 = nunca para este producto.
  reminderDays    Int?
  reminderMessage String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  variants       ProductVariant[]
  branchProducts BranchProduct[]
  comboItems     ComboItem[]
  reminders      CustomerReminder[]

  @@map("products")
}

// Tamaño / variante — cada variante tiene su propia receta independiente.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // ej. "Chico", "Mediano", "Grande", "Único", "Por Kilo"
  price     Decimal @db.Decimal(10, 2)
  isActive  Boolean @default(true)

  // Eje de temperatura real (antes se inferría parseando el nombre de la
  // variante, ver docs/CONTINUE.md "Mejoras avanzadas de POS") — null si
  // el producto no usa este eje.
  temperature VariantTemperature?
  // Tamaño real de la bebida en onzas — createSale (actions/pos.ts) lo usa
  // para elegir automáticamente el vaso (Ingredient.cupCapacityOz) que se
  // descuenta, sin que la receta lo liste como ingrediente. Null si el
  // producto no es una bebida (ej. REVENTA_DIRECTA) o no aplica.
  sizeOz      Decimal?            @db.Decimal(6, 2)
  // Solo para merch/souvenirs (ProductType.REVENTA_DIRECTA) — talla/color/
  // nota opcionales, sin uso en bebidas.
  size        String?
  color       String?
  note        String?

  // Costo de producción calculado en el momento en que se fijó/revisó
  // `price` por última vez. Se compara contra el costo actual calculado de
  // la receta activa; si el costo actual sube más de 20% sobre este valor,
  // se dispara la alerta de "margen afectado". Se actualiza cuando el
  // gerente ajusta el precio o descarta la alerta.
  costAtLastPriceReview Decimal? @db.Decimal(10, 2)

  recipes            Recipe[]
  modifierGroups     VariantModifierGroup[]
  saleItems          SaleItem[]
  comboItems         ComboItem[]
  promotionVariants  PromotionVariant[]
  loyaltyTierRewards LoyaltyTier[]
  discountCodes      DiscountCode[]

  @@map("product_variants")
}

// Disponibilidad de producto por sucursal — cada sucursal puede tener su
// propio subconjunto de catálogo, y se puede marcar inactivo/agotado sin
// borrar del catálogo global.
model BranchProduct {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  isActive  Boolean @default(true) // agotado / fuera de temporada en esa sucursal

  @@unique([branchId, productId])
  @@map("branch_products")
}

// Receta versionada — cada cambio genera una nueva versión, preservando
// historial para costeo retroactivo de ventas pasadas.
model Recipe {
  id               String          @id @default(cuid())
  kind             RecipeKind      @default(PRODUCTO_VENDIBLE)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  // Cuando kind = INGREDIENTE_COMPUESTO, esta receta representa cómo se
  // arma un ingrediente compuesto (ej. jarabe casero) y no se liga a un
  // ProductVariant sino que se referencia desde RecipeIngredient.composedById
  name             String? // requerido cuando kind = INGREDIENTE_COMPUESTO

  versions                   RecipeVersion[]
  usedAsComposedIngredientIn RecipeIngredient[] @relation("ComposedIngredientUsage")

  @@map("recipes")
}

model RecipeVersion {
  id            String    @id @default(cuid())
  recipeId      String
  recipe        Recipe    @relation(fields: [recipeId], references: [id])
  versionNumber Int
  isActive      Boolean   @default(true) // sólo una versión activa a la vez por Recipe
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  notes         String? // ej. "cambio de marca de jarabe", "ajuste sin azúcar"

  ingredients RecipeIngredient[]
  saleItems   SaleItem[] // referencia a qué versión se usó al momento de la venta
  costHistory RecipeCostHistory[]

  @@unique([recipeId, versionNumber])
  @@map("recipe_versions")
}

// Snapshot del costo total calculado de una RecipeVersion en un momento
// dado. Se inserta cuando el costo cambia de forma significativa (ej. tras
// un IngredientCostHistory) y sirve tanto para reportes históricos de costo
// como para saber exactamente cuánto costaba producir la bebida en la fecha
// de una venta específica.
model RecipeCostHistory {
  id              String        @id @default(cuid())
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id])
  totalCost       Decimal       @db.Decimal(10, 2)
  recordedAt      DateTime      @default(now())
  reason          String? // ej. "cambio de costo de Café en grano", "snapshot de venta"

  @@map("recipe_cost_history")
}

// Una línea de receta consume exactamente UNO de los dos:
//   - un Ingredient atómico (ingredientId), o
//   - un Recipe de tipo INGREDIENTE_COMPUESTO (composedRecipeId), ej. un
//     jarabe casero que a su vez tiene su propia RecipeVersion con
//     ingredientes atómicos.
// Regla de negocio (no forzable nativamente en Prisma): exactamente uno de
// ingredientId / composedRecipeId debe estar presente. Validar en app o
// agregar un CHECK constraint vía migración SQL manual.
// COSTO: no se almacena costo fijo en ningún lado. Se calcula SIEMPRE de
// forma recursiva y automática en tiempo de consulta:
//   costo(RecipeIngredient) =
//     si ingredientId      -> quantity * IngredientSupplier.cost (isSelected=true)
//     si composedRecipeId  -> quantity * (suma recursiva del costo de la
//                              RecipeVersion activa de esa Recipe compuesta)
// Esto asegura que el costo de un jarabe casero siempre refleje el costo
// actual de sus insumos atómicos, sin mantenimiento manual. La app debe
// prevenir ciclos (Receta A compuesta de B y B compuesta de A) al guardar,
// ya que el schema no lo puede restringir.
model RecipeIngredient {
  id              String        @id @default(cuid())
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id])

  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])

  composedRecipeId String?
  composedRecipe   Recipe? @relation("ComposedIngredientUsage", fields: [composedRecipeId], references: [id])

  quantity Decimal       @db.Decimal(12, 4)
  unit     UnitOfMeasure

  @@map("recipe_ingredients")
}

// =========================================================================
// MODIFICADORES / EXTRAS
// =========================================================================

// Grupo de modificadores aplicable a una variante (ej. "Tipo de leche",
// "Shots extra", "Jarabe adicional").
model VariantModifierGroup {
  id               String         @id @default(cuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  name             String
  isRequired       Boolean        @default(false)
  allowMultiple    Boolean        @default(false)

  options ModifierOption[]

  @@map("variant_modifier_groups")
}

// Cada opción puede descontar inventario de un ingrediente específico
// (ej. "Shot extra" -> +1 ESPRESSO_SHOT de café; "Leche deslactosada" ->
// sustituye el ingrediente leche).
model ModifierOption {
  id             String               @id @default(cuid())
  groupId        String
  group          VariantModifierGroup @relation(fields: [groupId], references: [id])
  name           String // ej. "Shot extra", "Leche deslactosada", "Doble carga de chai"
  priceDelta     Decimal              @default(0) @db.Decimal(10, 2)
  ingredientId   String?
  ingredient     Ingredient?          @relation(fields: [ingredientId], references: [id])
  quantityDelta  Decimal?             @db.Decimal(12, 4) // cantidad a sumar/restar del ingrediente
  unit           UnitOfMeasure?
  isSubstitution Boolean              @default(false) // true = reemplaza ingrediente base en vez de sumar

  saleItemModifiers SaleItemModifier[]

  @@map("modifier_options")
}

// =========================================================================
// COMBOS
// =========================================================================

model Combo {
  id       String  @id @default(cuid())
  name     String
  price    Decimal @db.Decimal(10, 2) // precio único del combo (utilidad se calcula agregada)
  isActive Boolean @default(true)

  // Vigencia por día/horario — mismo shape que Promotion, para que las 3
  // categorías del módulo Promociones (Paquetes/2x1/Día temático)
  // compartan una noción de "cuándo aplica". Vacío/null = todo el
  // tiempo. Sin manejo de zona horaria especial — hora del servidor,
  // igual que el resto del sistema (ver docs/CONTINUE.md).
  daysOfWeek Int[]   @default([]) // 0=domingo…6=sábado, vacío = todos
  startTime  String? // "HH:mm", null = todo el día
  endTime    String?

  items     ComboItem[]
  saleItems SaleItem[]

  @@map("combos")
}

model ComboItem {
  id               String          @id @default(cuid())
  comboId          String
  combo            Combo           @relation(fields: [comboId], references: [id])
  // El paquete combina por PRODUCTO, no por variante exacta — cualquier
  // variante activa del producto (ej. Americano Frío o Caliente) cuenta
  // para esta línea; el cliente/cajero elige la variante al vender.
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  // Variante "representativa" elegida al armar el paquete — solo para
  // estimar el ahorro mostrado en el editor, no restringe qué variante
  // califica al vender (ver applyPromotions en actions/pos.ts).
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity         Int             @default(1)

  @@map("combo_items")
}

enum PromotionCategory {
  DOS_POR_UNO
  DIA_TEMATICO
}

// 2x1 y Día temático — Paquetes vive en Combo/ComboItem arriba (ya
// existían en el schema desde antes de este módulo, solo nunca se
// habían implementado). Ambas categorías comparten vigencia por
// día/horario (mismo shape que Combo, ver comentario ahí).
model Promotion {
  id       String            @id @default(cuid())
  name     String
  category PromotionCategory
  isActive Boolean           @default(true)

  daysOfWeek Int[]   @default([]) // 0=domingo…6=sábado, vacío = todos
  startTime  String? // "HH:mm", null = todo el día
  endTime    String?

  // Solo DIA_TEMATICO — 2x1 no necesita tipo/valor de descuento, su
  // mecánica ya está fija (cobrar la mitad redondeando hacia arriba).
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)

  variants PromotionVariant[]

  @@map("promotions")
}

model PromotionVariant {
  id               String         @id @default(cuid())
  promotionId      String
  promotion        Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([promotionId, productVariantId])
  @@map("promotion_variants")
}

// =========================================================================
// USUARIOS / ROLES / PERMISOS
// =========================================================================

model Employee {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  pin          String? // login por PIN, alternativa a password
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches                  EmployeeBranch[]
  inventoryMovements        InventoryMovement[]
  sales                     Sale[]
  cashiersShifts            Shift[]             @relation("ShiftCashier")
  shiftsOpeningConfirmed    Shift[]             @relation("ShiftOpeningConfirmedBy")
  shiftsClosingConfirmed    Shift[]             @relation("ShiftClosingConfirmedBy")
  cashMovements             CashMovement[]
  purchaseOrders            PurchaseOrder[]
  physicalCounts            PhysicalCount[]     @relation("CountPerformedBy")
  approvedCounts            PhysicalCount[]     @relation("CountApprovedBy")
  manualDiscountsAuthorized ManualDiscount[]    @relation("ManualDiscountAuthorizedBy")
  transfersInitiated        TransferManifest[]  @relation("TransferInitiatedBy")
  transfersReceived         TransferManifest[]  @relation("TransferReceivedBy")
  saleItemVoids             SaleItemVoid[]      @relation("SaleItemVoidBy")
  saleItemVoidsAuthorized   SaleItemVoid[]      @relation("SaleItemVoidAuthorizedBy")

  @@map("employees")
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique

  permissions      RolePermission[]
  employeeBranches EmployeeBranch[]

  @@map("roles")
}

model RolePermission {
  id         String     @id @default(cuid())
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission

  @@unique([roleId, permission])
  @@map("role_permissions")
}

// Un empleado puede trabajar en varias sucursales, con distinto rol en
// cada una (empleado por sucursal por defecto, pero soporta multi-sucursal).
model EmployeeBranch {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  isPrimary  Boolean  @default(true) // sucursal "base" del empleado
  // Designación de "cajero", activable/desactivable independientemente del
  // rol (aplica tanto a BARISTA como a GERENTE). Un empleado solo puede ser
  // asignado como Shift.cashierId en esa sucursal si isCashier = true.
  isCashier  Boolean  @default(false)

  permissionOverrides EmployeePermissionOverride[]

  @@unique([employeeId, branchId])
  @@map("employee_branches")
}

// Excepción de permiso para un empleado en una sucursal específica.
// isGranted = true  -> otorga un permiso que su rol NO tiene por defecto
// isGranted = false -> revoca un permiso que su rol SÍ tiene por defecto
// El permiso "efectivo" de un empleado = permisos del Role, aplicando
// estas excepciones encima (override gana siempre sobre el rol).
model EmployeePermissionOverride {
  id               String         @id @default(cuid())
  employeeBranchId String
  employeeBranch   EmployeeBranch @relation(fields: [employeeBranchId], references: [id])
  permission       Permission
  isGranted        Boolean
  notes            String?
  createdAt        DateTime       @default(now())

  @@unique([employeeBranchId, permission])
  @@map("employee_permission_overrides")
}

// =========================================================================
// MOVIMIENTOS DE INVENTARIO / CONTEOS FÍSICOS
// =========================================================================

model InventoryMovement {
  id              String        @id @default(cuid())
  type            MovementType
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4) // positivo = entrada, negativo = salida
  unit            UnitOfMeasure

  branchId String?
  branch   Branch? @relation("MovementBranch", fields: [branchId], references: [id])

  // Sólo aplica para TRANSFERENCIA_* — referencia a sucursal origen/destino
  transferFromBranchId String?
  transferFromBranch   Branch? @relation("TransferOutBranch", fields: [transferFromBranchId], references: [id])
  transferToBranchId   String?
  transferToBranch     Branch? @relation("TransferInBranch", fields: [transferToBranchId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String?
  shift      Shift?   @relation(fields: [shiftId], references: [id])

  relatedSaleItemId String?
  saleItem          SaleItem? @relation(fields: [relatedSaleItemId], references: [id])

  // Presente cuando type = TRANSFERENCIA_SALIDA/ENTRADA — liga el movimiento
  // a la línea de TransferManifest que lo generó.
  transferLineId String?
  transferLine   TransferLine? @relation(fields: [transferLineId], references: [id])

  notes     String?
  createdAt DateTime @default(now())

  @@map("inventory_movements")
}

model PhysicalCount {
  id            String              @id @default(cuid())
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id])
  status        PhysicalCountStatus @default(ABIERTO)
  performedById String
  performedBy   Employee            @relation("CountPerformedBy", fields: [performedById], references: [id])
  approvedById  String?
  approvedBy    Employee?           @relation("CountApprovedBy", fields: [approvedById], references: [id])
  startedAt     DateTime            @default(now())
  closedAt      DateTime?

  lines PhysicalCountLine[]

  @@map("physical_counts")
}

model PhysicalCountLine {
  id              String        @id @default(cuid())
  physicalCountId String
  physicalCount   PhysicalCount @relation(fields: [physicalCountId], references: [id])
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  theoreticalQty  Decimal       @db.Decimal(12, 4) // congelado al momento del conteo
  physicalQty     Decimal       @db.Decimal(12, 4)
  unit            UnitOfMeasure

  @@map("physical_count_lines")
}

// La inicia administración (fromStockLocation típicamente BODEGA_CENTRAL,
// aunque también soporta sucursal-a-sucursal), la recibe gerente o barista
// delegado en destino. El movimiento de inventario real (InventoryMovement,
// tipo TRANSFERENCIA_SALIDA / TRANSFERENCIA_ENTRADA) se genera en cada
// transición de estado, ligado vía TransferLine.
model TransferManifest {
  id     String         @id @default(cuid())
  status TransferStatus @default(ENVIADO)

  fromStockLocationId String
  fromStockLocation   StockLocation @relation("TransferOrigin", fields: [fromStockLocationId], references: [id])
  toStockLocationId   String
  toStockLocation     StockLocation @relation("TransferDestination", fields: [toStockLocationId], references: [id])

  initiatedById String
  initiatedBy   Employee  @relation("TransferInitiatedBy", fields: [initiatedById], references: [id])
  receivedById  String?
  receivedBy    Employee? @relation("TransferReceivedBy", fields: [receivedById], references: [id])

  sentAt      DateTime  @default(now())
  inTransitAt DateTime?
  receivedAt  DateTime?
  notes       String?

  lines TransferLine[]

  @@map("transfer_manifests")
}

model TransferLine {
  id                 String           @id @default(cuid())
  transferManifestId String
  transferManifest   TransferManifest @relation(fields: [transferManifestId], references: [id])
  ingredientId       String
  ingredient         Ingredient       @relation(fields: [ingredientId], references: [id])
  quantity           Decimal          @db.Decimal(12, 4) // cantidad enviada
  unit               UnitOfMeasure

  // Si lo recibido no coincide con lo enviado (ej. se rompió en el camino),
  // se captura aquí y el sistema genera automáticamente un InventoryMovement
  // tipo MERMA por la diferencia, con nota visible en la auditoría de la
  // sucursal receptora. receivedQuantity = quantity si no hubo discrepancia.
  receivedQuantity Decimal? @db.Decimal(12, 4)
  discrepancyNote  String?

  movements InventoryMovement[]

  @@map("transfer_lines")
}

// =========================================================================
// COMPRAS
// =========================================================================

// Punto de reorden por ingrediente + ubicación de stock (distinto del
// bloqueo de venta de Fase 1, que se calcula contra el máximo de las
// recetas activas). manualThreshold lo define el usuario; la sugerencia
// dinámica basada en consumo de los últimos 15 días se calcula en query
// time contra InventoryMovement (type = VENTA), no se persiste aquí.
model ReorderPoint {
  id              String        @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  manualThreshold Decimal       @db.Decimal(12, 4)
  unit            UnitOfMeasure
  updatedAt       DateTime      @updatedAt

  @@unique([ingredientId, stockLocationId])
  @@map("reorder_points")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id])
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  employeeId String
  employee   Employee            @relation(fields: [employeeId], references: [id])
  status     PurchaseOrderStatus @default(CREADA)
  createdAt  DateTime            @default(now())
  receivedAt DateTime?

  // Fecha en que se marcó como pagada (captura manual). Se compara contra
  // createdAt para medir cuántos días tarda el proveedor en surtir.
  paidAt DateTime?

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])

  orderedQuantity  Decimal       @db.Decimal(12, 4)
  // null hasta que se registra la recepción; permite recepción parcial
  // (orderedQuantity - receivedQuantity = pendiente).
  receivedQuantity Decimal?      @db.Decimal(12, 4)
  unit             UnitOfMeasure

  // Presentación con la que se capturó la línea (copia al momento de crear
  // la orden): orderedQuantity/receivedQuantity/costos SIEMPRE se guardan en
  // baseUnit, y estos campos solo sirven para mostrarlos y capturar la
  // recepción en la misma presentación (ver lib/units.ts).
  presentationName     String?
  unitsPerPresentation Decimal? @db.Decimal(12, 4)

  estimatedUnitCost Decimal  @db.Decimal(10, 4)
  // capturado al recibir, para ver variación estimado vs. real
  actualUnitCost    Decimal? @db.Decimal(10, 4)

  batches IngredientBatch[]

  @@map("purchase_order_items")
}

// =========================================================================
// CAJA / TURNOS
// =========================================================================

model Shift {
  id        String      @id @default(cuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  type      ShiftType
  status    ShiftStatus @default(ABIERTO)
  cashierId String
  cashier   Employee    @relation("ShiftCashier", fields: [cashierId], references: [id])

  // Confirmación de apertura: preferentemente gerente, pero puede ser
  // cualquier otro empleado (distinto del cajero) si el gerente no está
  // disponible por incapacidad, día libre, u otra diligencia.
  openingConfirmedById String?
  openingConfirmedBy   Employee? @relation("ShiftOpeningConfirmedBy", fields: [openingConfirmedById], references: [id])
  openingConfirmedAt   DateTime?

  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @default(0) @db.Decimal(10, 2)
  closingCash Decimal?  @db.Decimal(10, 2) // conteo físico al corte

  // Total esperado (apertura + ventas efectivo - retiros + ingresos),
  // calculado SOLO al momento del corte, nunca en tiempo real.
  expectedCash     Decimal? @db.Decimal(10, 2)
  // closingCash - expectedCash. Si no es 0, se requiere differenceReason.
  cashDifference   Decimal? @db.Decimal(10, 2)
  differenceReason String?

  // El turno no puede pasar a CERRADO hasta que ambas confirmaciones existan
  // (evidencia de doble firma). closingConfirmedBy sigue el mismo criterio
  // de flexibilidad que openingConfirmedBy: gerente de preferencia, o
  // cualquier otro empleado si no está disponible.
  cashierConfirmedAt   DateTime?
  closingConfirmedById String?
  closingConfirmedBy   Employee? @relation("ShiftClosingConfirmedBy", fields: [closingConfirmedById], references: [id])
  closingConfirmedAt   DateTime?

  sales              Sale[]
  cashMovements      CashMovement[]
  inventoryMovements InventoryMovement[]

  @@map("shifts")
}

model CashMovement {
  id         String           @id @default(cuid())
  shiftId    String
  shift      Shift            @relation(fields: [shiftId], references: [id])
  type       CashMovementType
  amount     Decimal          @db.Decimal(10, 2)
  reason     String // ej. "compra de hielo"
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  createdAt  DateTime         @default(now())

  @@map("cash_movements")
}

// =========================================================================
// CLIENTES / LEALTAD
// =========================================================================

enum CustomerGender {
  FEMENINO
  MASCULINO
  OTRO
}

enum PetSpecies {
  PERRO
  GATO
  OTRO
}

// Mascota de un cliente (un tutor puede tener varias).
model Pet {
  id             String     @id @default(cuid())
  customerId     String
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name           String
  species        PetSpecies @default(PERRO)
  breed          String?
  weightKg       Decimal?   @db.Decimal(5, 2)
  birthDate      DateTime?  @db.Date
  // Cuándo se capturó o cambió birthDate: un cupón de cumpleaños solo se
  // entrega si la fecha ya estaba registrada antes de ese cumpleaños (que
  // no se pueda capturar "hoy" para sacar un cupón, lib/birthdays.ts).
  // null = registrada antes de que existiera este campo.
  birthDateSetAt DateTime?
  photoUrl       String?
  // Alergias y restricciones (ej. "pollo", "lácteos"): el POS avisa si se
  // agrega un producto que las contiene (Product.allergenTags).
  allergies      String[]   @default([])
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  birthdayGrants BirthdayGrant[]

  @@index([customerId])
  @@map("pets")
}

// Cupón de cumpleaños ya entregado: uno por festejado y año.
model BirthdayGrant {
  id             String        @id @default(cuid())
  // "CLIENTE:<customerId>" o "MASCOTA:<petId>" — una sola llave para el
  // @@unique (un petId null no cuenta como repetido en Postgres).
  subjectKey     String
  year           Int
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  petId          String?
  pet            Pet?          @relation(fields: [petId], references: [id], onDelete: SetNull)
  discountCodeId String?       @unique
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([subjectKey, year])
  @@map("birthday_grants")
}

enum ReminderKind {
  CAFE_TE_EXTRANAMOS
  PET_SHOP_RESURTIDO
}

enum ReminderAction {
  ENVIADO
  OMITIDO
}

// Un recordatorio ya atendido (mandado por WhatsApp u omitido). Uno vuelve
// a salir solo después de una compra nueva posterior a este registro
// (lib/reminders.ts). Pet Shop guarda uno por producto; Cafetería sin
// producto.
model CustomerReminder {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       ReminderKind
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  action     ReminderAction
  employeeId String?
  createdAt  DateTime       @default(now())

  @@index([customerId, kind])
  @@map("customer_reminders")
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  birthDate      DateTime?
  // Cuándo se capturó o cambió birthDate: un cupón de cumpleaños solo se
  // entrega si la fecha ya estaba registrada antes de ese cumpleaños (que
  // no se pueda capturar "hoy" para sacar un cupón, lib/birthdays.ts).
  // null = registrada antes de que existiera este campo.
  birthDateSetAt DateTime?
  // Opcional a propósito — los clientes ya registrados no lo tienen, y no
  // se pide de vuelta a fuerza. Solo para las estadísticas de
  // Administración → Clientes (ver lib/customers.ts getCustomerStats).
  gender         CustomerGender?
  email          String?         @unique
  phone          String?         @unique
  address        String? // para pedidos "A domicilio"
  createdAt      DateTime        @default(now())

  loyaltyCard     LoyaltyCard?
  sales           Sale[]
  discountCodes   DiscountCode[]
  loyaltyBalances LoyaltyBalance[]
  loyaltyEntries  LoyaltyPointsEntry[]
  tierGrants      LoyaltyTierGrant[]
  pets            Pet[]
  birthdayGrants  BirthdayGrant[]
  reminders       CustomerReminder[]

  @@map("customers")
}

model LoyaltyCard {
  id         String       @id @default(cuid())
  customerId String       @unique
  customer   Customer     @relation(fields: [customerId], references: [id])
  stamps     Int          @default(0) // sellos acumulados, reinician cada 5
  tierId     String?
  tier       LoyaltyTier? @relation(fields: [tierId], references: [id])
  // Código único de la tarjeta física (impreso como QR) — un lector tipo
  // teclado lo escribe tal cual en la búsqueda de cliente del checkout.
  // Con @default, solo las tarjetas creadas a partir de este cambio lo
  // tienen; las ya existentes quedan en null (no hay backfill).
  code       String?      @unique @default(cuid())
  createdAt  DateTime     @default(now())

  @@map("loyalty_cards")
}

// Nivel de un programa de lealtad: se alcanza al juntar `pointsRequired`
// puntos en ese programa y, al alcanzarlo, se entrega su recompensa como
// cupón personal (ver lib/loyalty-points.ts).
model LoyaltyTier {
  id                String            @id @default(cuid())
  program           LoyaltyProgram    @default(CAFE)
  name              String
  pointsRequired    Int               @default(0)
  // Legado (visitas). Se conserva para que la versión anterior de la app
  // siga cobrando entre `migrate deploy` y el reinicio, y para poder
  // regresar a ella; se quita en una migración posterior.
  minLifetimeStamps Int               @default(0)
  benefits          String? // texto libre que ve el cliente
  rewardType        LoyaltyRewardType @default(NINGUNA)
  rewardPercent     Int? // CUPON_PORCENTAJE / DESCUENTO_PERMANENTE
  rewardVariantId   String? // PRODUCTO_GRATIS
  rewardVariant     ProductVariant?   @relation(fields: [rewardVariantId], references: [id])
  rewardValidDays   Int? // cupones de un uso; null = sin vencimiento

  cards  LoyaltyCard[] // legado (LoyaltyCard.tierId, de la época de sellos)
  grants LoyaltyTierGrant[]

  @@unique([program, name])
  @@map("loyalty_tiers")
}

// Saldo de puntos de un cliente en un programa. Se llevan CAFE, PET_SHOP y
// GLOBAL (la suma) siempre, sin importar el modo.
model LoyaltyBalance {
  id             String         @id @default(cuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  program        LoyaltyProgram
  points         Int            @default(0) // del ciclo actual (= lifetime si no se reinicia)
  lifetimePoints Int            @default(0)
  cycle          Int            @default(0) // vueltas completas (loyaltyResetAtTopLevel)
  updatedAt      DateTime       @updatedAt

  @@unique([customerId, program])
  @@map("loyalty_balances")
}

// Bitácora de movimientos de puntos — historial del cliente y, más
// adelante, la cola de avisos por WhatsApp (notifiedAt).
model LoyaltyPointsEntry {
  id         String             @id @default(cuid())
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id])
  program    LoyaltyProgram
  points     Int // negativo en cancelaciones y reinicios
  reason     LoyaltyEntryReason
  cycle      Int? // REINICIO: ciclo que se cerró (para poder deshacerlo)
  saleId     String?
  sale       Sale?              @relation(fields: [saleId], references: [id])
  createdAt  DateTime           @default(now())
  notifiedAt DateTime?

  @@index([customerId, createdAt])
  @@index([saleId])
  @@map("loyalty_points_entries")
}

// Nivel cruzado por una compra (una vez por ciclo) y el cupón con que se
// entregó su recompensa. Guarda el programa y el umbral de ese momento:
// editar o borrar el nivel después no cambia si este cupón se ganó.
model LoyaltyTierGrant {
  id             String         @id @default(cuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  tierId         String?
  tier           LoyaltyTier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)
  program        LoyaltyProgram
  pointsRequired Int
  cycle          Int
  saleId         String?
  sale           Sale?          @relation(fields: [saleId], references: [id])
  discountCodeId String?        @unique
  discountCode   DiscountCode?  @relation(fields: [discountCodeId], references: [id])
  createdAt      DateTime       @default(now())

  @@unique([customerId, tierId, cycle])
  @@map("loyalty_tier_grants")
}

// =========================================================================
// VENTAS
// =========================================================================

model Sale {
  id                 String           @id @default(cuid())
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id])
  shiftId            String
  shift              Shift            @relation(fields: [shiftId], references: [id])
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id])
  customerId         String?
  customer           Customer?        @relation(fields: [customerId], references: [id])
  status             SaleStatus       @default(COMPLETADA)
  orderType          SaleOrderType    @default(PARA_LLEVAR)
  tableNumber        String? // solo aplica cuando orderType = CONSUMO_LOCAL ("Mesa")
  domicilioOrigen    DomicilioOrigen? // solo aplica cuando orderType = DOMICILIO
  subtotal           Decimal          @db.Decimal(10, 2)
  discountTotal      Decimal          @default(0) @db.Decimal(10, 2)
  total              Decimal          @db.Decimal(10, 2) // IVA incluido
  // Propina: se cobra junto con la venta (los pagos suman total + tipAmount)
  // pero NO es ingreso por ventas — reportes siguen usando `total`.
  tipAmount          Decimal          @default(0) @db.Decimal(10, 2)
  // IVA contenido en `total` cuando la sucursal tiene taxMode INCLUIDO
  // (0 si no se desglosa) — no cambia el total cobrado.
  taxAmount          Decimal          @default(0) @db.Decimal(10, 2)
  createdAt          DateTime         @default(now())
  cancelledAt        DateTime?
  cancelledById      String?
  // Motivo capturado al anular (cancelSale en actions/pos.ts) — obligatorio
  // para auditoría; la anulación exige PIN de alguien con VENTA_CANCELAR.
  cancelReason       String?
  // Id que genera el POS por cada intento de cobro y reutiliza en los
  // reintentos: si la red se cae DESPUÉS de que el servidor registró la
  // venta, reintentar con el mismo id regresa la venta existente en vez de
  // cobrar dos veces (QA-015).
  clientRequestId    String?          @unique
  // Id del último "agregar ronda" aplicado a una cuenta abierta
  // (addItemsToTab) — no es única globalmente (solo se compara contra la
  // misma venta): si la red se cae después de aplicar la ronda, reintentar
  // con el mismo id no la vuelve a agregar.
  lastRoundRequestId String?

  items          SaleItem[]
  payments       SalePayment[]
  discountCode   DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  discountCodeId String?
  manualDiscount ManualDiscount?
  loyaltyEntries LoyaltyPointsEntry[]
  tierGrants     LoyaltyTierGrant[]
  itemVoids      SaleItemVoid[]

  @@map("sales")
}

model SaleItem {
  id               String          @id @default(cuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  comboId          String?
  combo            Combo?          @relation(fields: [comboId], references: [id])
  recipeVersionId  String? // snapshot de qué versión de receta se usó
  recipeVersion    RecipeVersion?  @relation(fields: [recipeVersionId], references: [id])
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(10, 2)
  lineTotal        Decimal         @db.Decimal(10, 2)
  notes            String? // ej. "sin azúcar", "bien caliente"
  // Para la ventana de corrección libre de una cuenta abierta (ver
  // TAB_FREE_CORRECTION_MINUTES en actions/pos.ts). Las filas anteriores a
  // esta columna quedan con la fecha de la migración.
  createdAt        DateTime        @default(now())

  modifiers             SaleItemModifier[]
  ingredientAdjustments SaleItemIngredientAdjustment[]
  inventoryMovements    InventoryMovement[]

  @@map("sale_items")
}

// Bitácora de productos quitados (o con cantidad reducida) de una cuenta
// abierta antes de cobrarla — removeTabItem/updateTabItemQuantity. Sin
// esto, servir un producto, quitarlo de la cuenta y cobrar el resto no
// dejaba ningún rastro más que un movimiento de inventario. Pasada la
// ventana de corrección libre, la exige un PIN con VENTA_CANCELAR
// (authorizedById); dentro de ella queda null.
model SaleItemVoid {
  id             String    @id @default(cuid())
  saleId         String
  sale           Sale      @relation(fields: [saleId], references: [id])
  // Texto, no FK: el SaleItem se borra al quitarlo por completo.
  description    String
  quantity       Int
  amount         Decimal   @db.Decimal(10, 2)
  employeeId     String
  employee       Employee  @relation("SaleItemVoidBy", fields: [employeeId], references: [id])
  authorizedById String?
  authorizedBy   Employee? @relation("SaleItemVoidAuthorizedBy", fields: [authorizedById], references: [id])
  createdAt      DateTime  @default(now())

  @@index([saleId])
  @@map("sale_item_voids")
}

// Ajustes libres a nivel de ingrediente sobre la receta base de una línea
// de venta (más allá de los ModifierOption curados). QUITAR no afecta
// precio; AUMENTAR y AGREGAR_EXTRA sí, vía priceDelta calculado con
// Ingredient.extraUnitPrice * quantity.
model SaleItemIngredientAdjustment {
  id           String                   @id @default(cuid())
  saleItemId   String
  saleItem     SaleItem                 @relation(fields: [saleItemId], references: [id])
  ingredientId String
  ingredient   Ingredient               @relation(fields: [ingredientId], references: [id])
  type         IngredientAdjustmentType
  quantity     Decimal                  @db.Decimal(12, 4)
  unit         UnitOfMeasure
  priceDelta   Decimal                  @default(0) @db.Decimal(10, 2)

  @@map("sale_item_ingredient_adjustments")
}

model SaleItemModifier {
  id               String         @id @default(cuid())
  saleItemId       String
  saleItem         SaleItem       @relation(fields: [saleItemId], references: [id])
  modifierOptionId String
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])
  priceDelta       Decimal        @db.Decimal(10, 2)

  @@map("sale_item_modifiers")
}

model SalePayment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2) // incluye tipAmount
  // Parte de `amount` que es propina — en pago dividido cada persona deja
  // la suya; permite separar en el corte propinas en efectivo vs tarjeta/
  // transferencia (las que hay que pagar al personal en efectivo).
  tipAmount Decimal       @default(0) @db.Decimal(10, 2)
  note      String? // ej. banco/referencia cuando method = TRANSFERENCIA

  @@map("sale_payments")
}

model DiscountCode {
  id         String       @id @default(cuid())
  code       String       @unique
  type       DiscountType
  value      Decimal      @db.Decimal(10, 2)
  isActive   Boolean      @default(true)
  expiresAt  DateTime?
  // Si no es null, este código es personal (ej. el cupón de bienvenida
  // que se genera al registrar al cliente, ver actions/customers.ts) —
  // solo se puede aplicar a una venta de ESE cliente, y solo una vez
  // (usedAt). Un código sin customerId sigue siendo genérico/reusable
  // como hasta ahora.
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  usedAt     DateTime?

  // Subcategoría para el módulo Promociones — ver DiscountCodeCategory.
  category DiscountCodeCategory?

  // Alcance (cupones de lealtad y de cumpleaños): solo descuenta las
  // líneas de ese negocio; null = toda la cuenta.
  businessUnit     BusinessUnit?
  // Producto gratis: descuenta el precio de una pieza de esta variante si
  // está en la cuenta (type/value no se usan).
  productVariantId String?
  // Restrict: con SetNull, un cupón de "100% de este producto" se volvería
  // 100% de toda la cuenta si se borra la variante.
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  // Cupón personal reusable (descuento permanente de un nivel): no se
  // marca usado.
  isReusable       Boolean         @default(false)
  // Descuento permanente de este programa: uno por cliente; su % y si está
  // activo los decide el nivel actual (syncPermanentDiscounts).
  loyaltyProgram   LoyaltyProgram?

  sales         Sale[]
  tierGrant     LoyaltyTierGrant?
  birthdayGrant BirthdayGrant?

  @@unique([customerId, loyaltyProgram])
  @@map("discount_codes")
}

// Descuento manual autorizado por gerente (PIN/contraseña), independiente
// del flujo de DiscountCode escaneado. type determina cómo se interpreta
// value: PORCENTAJE (%), MONTO_FIJO (se resta del total), o PRECIO_FINAL
// (reemplaza el total de la venta). Aparece en el ticket como "descuento
// aprobado por gerente" junto con `reason`.
model ManualDiscount {
  id             String               @id @default(cuid())
  saleId         String               @unique
  sale           Sale                 @relation(fields: [saleId], references: [id])
  type           DiscountType
  value          Decimal              @db.Decimal(10, 2)
  reason         ManualDiscountReason
  authorizedById String
  authorizedBy   Employee             @relation("ManualDiscountAuthorizedBy", fields: [authorizedById], references: [id])
  createdAt      DateTime             @default(now())

  @@map("manual_discounts")
}
